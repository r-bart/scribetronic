{
  "name": "scribetronic",
  "version": "0.2.1",
  "description": "Editorial calendar + writing pipeline for Claude Code (CLI + plugin marketplace)",
  "type": "module",
  "bin": {
    "scribetronic": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": ["writing", "newsletter", "editorial-calendar", "claude-code", "ai", "cli"],
  "author": "Roberto Díaz (rbart)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/r-bart/scribetronic.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/r-bart/scribetronic#readme",
  "bugs": {
    "url": "https://github.com/r-bart/scribetronic/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
